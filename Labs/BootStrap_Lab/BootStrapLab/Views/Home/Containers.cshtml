<!-- This is the standard container -->
<div class="container">
    <h2>Standard Bootstrap Container</h2>
    <div class="content-box">
        This content is inside a standard container (.container).
        Notice how it has a maximum width at each breakpoint and is centered on the page.
    </div>
    <div class="content-box">
        Try resizing your browser window to see how the container width changes at different breakpoints:
        <ul>
            <li>xs (&lt;576px): 100% width</li>
            <li>sm (≥576px): 540px max-width</li>
            <li>md (≥768px): 720px max-width</li>
            <li>lg (≥992px): 960px max-width</li>
            <li>xl (≥1200px): 1140px max-width</li>
            <li>xxl (≥1400px): 1320px max-width</li>
        </ul>
    </div>
</div>

<!-- This is the fluid container -->
<div class="container-fluid">
    <h2>Fluid Bootstrap Container</h2>
    <div class="content-box">
        This content is inside a fluid container (.container-fluid).
        Notice how it always takes up the full width of the viewport, regardless of screen size.
    </div>
    <div class="fluid-content-box">
        Unlike the standard container:
        <ul>
            <li>The container-fluid always spans 100% of the viewport width</li>
            <li>It maintains the same padding on the sides</li>
            <li>It doesn't have maximum width limits at different breakpoints</li>
            <li>It's ideal for full-width layouts or when you want content to use all available space</li>
        </ul>
    </div>
</div>

<!-- container-sm example -->
<div class="container-sm">
    <h2>container-sm</h2>
    <div class="responsive-content-box box-sm">
        This is a container-sm.
        <ul>
            <li>Below 576px: 100% width (fluid)</li>
            <li>576px and above: Fixed maximum widths like a standard container</li>
        </ul>
    </div>
</div>

