@{
    ViewData["Title"] = "Pet Management - Ajax Demo";
}

<div class="container mt-5">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-4 text-primary">Pet Management System</h1>
            <p class="lead text-muted">Demonstrating CRUD Operations with Ajax</p>
        </div>
    </div>

    <!-- Create/Edit Pet Form -->
    <div class="row mb-5">
        <div class="col-lg-6 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0" id="form-title">Add New Pet</h5>
                </div>
                <div class="card-body">
                    <form id="petForm">
                        <input type="hidden" id="Id" name="Id" value="0" />

                        <div class="mb-3">
                            <label for="Name" class="form-label">Pet Name</label>
                            <input type="text" class="form-control" id="Name" name="Name"
                                placeholder="Enter pet name" required>
                        </div>

                        <div class="mb-3">
                            <label for="Weight" class="form-label">Weight (lbs)</label>
                            <input type="number" step="0.1" class="form-control" id="Weight" name="Weight"
                                placeholder="Enter weight" required>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <button type="button" class="btn btn-secondary" id="cancelBtn" style="display: none;">Cancel</button>
                            <button type="submit" class="btn btn-primary" id="submitBtn">Add Pet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Alert Messages -->
    <div class="row">
        <div class="col">
            <div id="alertContainer"></div>
        </div>
    </div>

    <!-- Pets Display Section -->
    <div class="row mb-4">
        <div class="col text-center">
            <h2 class="mb-3">Current Pets</h2>
        </div>
    </div>

    <!-- Pet Cards Container -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="petCardsContainer">
        <!-- Sample Pet Card (Template/Example) -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary">Fluffy</h5>
                    <p class="card-text">
                        <strong>ID:</strong> 1<br>
                        <strong>Weight:</strong> 12.5 lbs
                    </p>
                </div>
                <div class="card-footer bg-transparent">
                    <button class="btn btn-sm btn-outline-primary" data-pet-id="1">
                        <i class="bi bi-pencil"></i> Edit
                    </button>
                    <button class="btn btn-sm btn-outline-danger" data-pet-id="1">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                </div>
            </div>
        </div>
        <!-- Additional pet cards will be dynamically generated here via Ajax -->
    </div>

    <!-- Empty State -->
    <div class="row" id="emptyState" style="display: none;">
        <div class="col text-center py-5">
            <div class="text-muted">
                <i class="bi bi-inbox" style="font-size: 4rem;"></i>
                <h4 class="mt-3">No Pets Found</h4>
                <p>Add your first pet using the form above!</p>
            </div>
        </div>
    </div>

    <!-- Loading Spinner -->
    <div class="row" id="loadingSpinner" style="display: none;">
        <div class="col text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2 text-muted">Loading pets...</p>
        </div>
    </div>
</div>

@section Scripts{
    <script defer type="module" src="~/js/petIndex.js"></script>
}
